# =====================================================================
# EKIP 仓库根环境变量配置示例
# ---------------------------------------------------------------------
# 使用说明：
#   1. 复制为 .env，并填写必填项：Copy-Item .env.example .env（PowerShell）
#      Git Bash：cp .env.example .env
#   2. .env 已被 .gitignore 忽略，填写后的文件不要提交到版本控制。
#   3. 修改容器环境后重新创建对应服务；仅改本文件不会改变运行中的容器。
#
# 配置加载：
#   - Compose 从根 .env 取插值；只有 docker-compose.yml 的 environment
#     明确引用的变量才会传入对应容器。写入根 .env 不等于注入全部服务。
#   - Python 本机运行（安装 python-dotenv 时）：进程环境 > ai/.env > 根 .env。
#   - Java 通用 Spring 配置不自动读取根 .env，裸跑需设置系统环境或启动参数；
#     模型凭证主密钥也须显式提供给 Java；Agent 统一走受治理的模型执行入口。
#   - 下方注释项是可选覆盖示例；E2/E3 标出的完整栈必需项应取消注释填写。
#
# 分组顺序：
#   A. 认证与访问控制    JWT、内部令牌、登录限流
#   B. 数据与存储        AI 只读 PostgreSQL、向量存储
#   C. 模型管理          凭证主密钥与共享资源
#   D. RAG 查询与证据策略 编排、预算、证据阈值、重排
#   E. 可观测性          OpenTelemetry、Langfuse
# =====================================================================


# #####################################################################
# A. 认证与访问控制
# #####################################################################

# ========== A1. JWT 签名与有效期（密钥必填）==========
# JWT 签名密钥；生成示例：openssl rand -base64 48。
# 按原始 UTF-8 字节使用，不做 Base64 解码；至少 32 字节。
# 生产环境应使用独立随机值，不能沿用历史仓库中的密钥。
# 轮换后重启 backend，已有访问令牌失效，用户需重新登录。
JWT_SECRET=
# 访问令牌有效期（分钟），默认 15；无状态校验，不逐请求查询 Redis。
JWT_ACCESS_EXPIRE_MINUTES=15
# 刷新令牌有效期（天），默认 7；jti 存 Redis，登出时可吊销。
JWT_REFRESH_EXPIRE_DAYS=7

# 可选。指定一个已经注册的用户名，启用「设置 → 账号管理」。
EKIP_ACCOUNT_ADMIN_USERNAME=

# ========== A2. Java → Python 内部鉴权（必填）==========
# 两侧必须同值；Compose 同时注入 ai 与 backend。
# AiServiceClient 与 AgentGatewayClient 均发送 X-Internal-Token，AI 校验失败返回 401。
# Python 按 Java 授权后传入的知识库范围检索；内部令牌保护这条调用边界。
# 生成示例：openssl rand -hex 32；缺失时 Compose 和 AI 启动均拒绝继续。
# 本机 uvicorn 可通过上述 dotenv 加载机制读取，无需再次手动导出。
INTERNAL_API_TOKEN=

# ========== A3. 登录限流（可选，以下为默认值）==========
# 按 IP + 用户名双维度计数；命中锁定返回 429 与 Retry-After。
LOGIN_THROTTLE_ENABLED=true
# 锁定前允许的失败次数，默认 5。
LOGIN_THROTTLE_MAX_ATTEMPTS=5
# 锁定时长（分钟），默认 15。
LOGIN_THROTTLE_LOCK_MINUTES=15
# 代理部署需由可信代理正确设置 X-Forwarded-For；backend 已使用 native 转发头策略。
# 未正确转发客户端 IP 时，同一代理后的用户会共享 IP 限流计数。


# #####################################################################
# B. 数据与存储
# #####################################################################

# ========== B1. AI PostgreSQL 只读账号（必填）==========
# AI 仅用独立只读账号检索，不继承 backend 的 POSTGRES_* 管理员凭据。
# Flyway V4/V5 创建 rag_readonly 并收窄权限；V5 不修改已有角色密码。
# 迁移后用 psql 的 \password rag_readonly 设置独立随机密码，须与下项一致。
# AI 读取的数据库名，默认 knowledge，与业务后端同库。
PG_READONLY_DB=knowledge
# 只读角色名；Compose 与 AI 均要求非空。
PG_READONLY_USER=rag_readonly
# 只读角色密码；Compose 与 AI 均要求非空，无默认值。
PG_READONLY_PASSWORD=
# Compose 网络内的数据库地址/端口；裸跑 Python 默认主机为 localhost。
# PG_READONLY_HOST=postgres
# PG_READONLY_PORT=5432
# 当前 Compose 的业务库 POSTGRES_*、Redis、MinIO 连接写在部署清单中，
# 不是根 .env 插值项；修改它们需同步调整 docker-compose.yml 的服务配置。
# 同一套 EKIP 后端共享任务通知频道。独立环境共用 Redis 时应设置不同的频道。
TASK_STATUS_BROADCAST_ENABLED=false
TASK_STATUS_BROADCAST_CHANNEL=ekip:document-task:v1

# ========== B2. 向量存储 ==========
# 唯一实现为 pgvector：同库1024/2560维向量表及HNSW；知识库按space/generation隔离。
# 其他值使后端装配失败，不会静默切回 pgvector。
VECTOR_STORE=pgvector


# #####################################################################
# C. 模型服务
# #####################################################################

# ========== C1. 模型管理凭证主密钥 ==========
# 个人模型、用途覆盖和 API Key 由模型管理保存；标准部署默认模型组由 MODEL_DEFAULT_* 配置。
# Java用独立AES-GCM主密钥加密凭证；Base64解码后必须正好32字节。
# 缺失时仍可管理无凭证的本地模型，但拒绝保存云端API Key，绝不明文回退。
# 本机Java普通启动不会自动读取本文件，须将主密钥提供给Java进程环境。
MODEL_CONFIG_ENCRYPTION_KEY=
# 本地默认模型服务（适用于 Docker Desktop；普通 Java 进程默认使用 localhost）。
MODEL_DEFAULT_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
MODEL_DEFAULT_RERANK_BASE_URL=http://host.docker.internal:8091/v1
# 与 scripts/start-local-reranker.ps1 生成并保存在忽略目录的服务密钥一致；不要提交真实值。
MODEL_DEFAULT_RERANK_API_KEY=
# AI本地模型共享GPU组；当前保证范围为单Python worker/实例。
MODEL_RESOURCE_GROUPS={"local-gpu":1}
MODEL_RESOURCE_QUEUE_LIMIT=8
# 配置和旧向量迁移见docs/model-management.md。


# #####################################################################
# D. RAG 查询与证据策略
# #####################################################################

# ========== D1. 编排默认实现（逐请求可覆盖）==========
# fixed / langchain；只选择编排实现，不改变检索策略、模型或证据阈值。
RAG_PIPELINE_ENGINE=fixed

# ========== D2. 查询预算与并发（可选，示例为 Compose 默认值）==========
# AI 查询总预算（毫秒），须 > 0；实际预算取本项与请求 budgetMs 的较小值。
# RAG 生成问答总预算。Compose 将同一值传入 Java 和 Python，单位毫秒。
# RAG_QUERY_DEADLINE_MS=270000
# 每进程最多同时处理的 RAG 查询数，须 > 0。
# RAG_QUERY_MAX_INFLIGHT=4
# 并行检索 worker 上限，至少 2；限制超时后仍在收尾的工作量。
# RAG_RETRIEVAL_MAX_INFLIGHT=4
# 向量/关键词单路检索超时（毫秒），默认 2000；总预算始终生效。
# 本地 Ollama 演示使用 10000，覆盖 Embedding 冷加载、资源等待与 SQL 查询。
# RETRIEVAL_LEG_TIMEOUT_MS=2000
# 请求允许的最大 Top-K 与召回候选数，均须 > 0。
# RAG_QUERY_MAX_TOP_K=20
# RAG_QUERY_MAX_RECALL_N=100
# 请求历史上限：消息条数 / 总字符数，均须 > 0。
# RAG_QUERY_MAX_HISTORY_MESSAGES=32
# RAG_QUERY_MAX_HISTORY_CHARS=30000

# ========== D3. 证据策略 ==========
# 本机 Python 直启时可临时启用；Docker 请用 docker-compose.dev-test.yml 覆盖层。
# 绕过 RAG 检索和证据准入，直接调用已授权的 generate 模型；答案无知识库依据，仅验证模型与真实文本流。
# Agent 请另用 general 策略；不要在共享或生产环境启用。
# EKIP_ENV=development
# RAG_DEV_TEST_MODE=true
# 全本地轻量组合使用 RETRIEVAL_VERSION=hybrid 与 RAG_EVIDENCE_MODE=support。
# Chat 同时绑定 generate / evidence_support，Embedding 绑定新知识库默认模型。
# RETRIEVAL_VERSION=hybrid-rerank-rewrite
# 重排校准记录与模型语义指纹绑定，使用模型管理接口；不再设置全局评分阈值。
# RAG_EVIDENCE_MODE=score
# RAG_EVIDENCE_POLICY_VERSION=fail-closed-v1
# 重排协议/地址/凭证/超时均在模型记录中配置，无隐式embed_sim回退。


# #####################################################################
# E. 可观测性
# #####################################################################

# ========== E1. OpenTelemetry（可选覆盖项）==========
# 默认业务 Compose 固定关闭 Java/Python 的外部追踪出口，保留指标、产品 Trace 和阶段日志。
# 完整观测方案通过 docker-compose.observability.yml 显式开启，不必在默认部署填写 E2/E3。
# 裸跑时如需向已配置的 Collector 导出，可在进程环境/对应 dotenv 显式设置：
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=ekip-ai
# 裸跑地址；Compose 完整方案默认使用 http://otel-collector:4318/v1/traces。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# 指标与阶段日志的默认值保持 true。
# METRICS_ENABLED=true
# RAG_STAGE_LOG_ENABLED=true

# ========== E2. Langfuse 安全配置（仅可选完整方案需填写）==========
# 仅完整观测方案启动 Collector、ClickHouse、Langfuse web/worker；默认业务方案不读取这些密钥。
# 选择完整方案时取消注释 E2/E3 并填写实际值；必需的安全项缺失时可选 Compose 配置会明确拒绝。
# 另需预先创建独立 langfuse 数据库；对象存储桶由 minio-init 创建。
# Web 会话签名密钥；使用独立随机值。
# LANGFUSE_NEXTAUTH_SECRET=
# Langfuse 敏感信息处理所用的盐；使用独立随机值并妥善保存。
# LANGFUSE_SALT=
# Langfuse 加密主密钥；按服务要求生成，升级时保留，不能随意轮换。
# LANGFUSE_ENCRYPTION_KEY=
# Collector 的 Basic 凭据：Base64(项目 public key:项目 secret key)，不带 Basic 前缀。
# 与 E3 的项目 Key 对保持一致，不是 Web 管理员登录密码。
# LANGFUSE_BASIC_AUTH=

# ========== E3. Langfuse 首次初始化（完整栈成套填写）==========
# 首次启动时预建组织、项目、用户及项目 API Key；名称、ID 与用户字段按实际填写。
# 组织标识 / 显示名。
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# 项目标识 / 显示名。
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# 项目 API Key 对；collector 的 LANGFUSE_BASIC_AUTH 由这对 Key 编码得到。
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# 首次初始化的登录用户邮箱、显示名与独立随机密码。
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=
