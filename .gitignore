# ===== 系统文件 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== IDE =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp

# ===== 后端构建产物 =====
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ===== Python / AI 服务 =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# AI 服务密钥与运行时数据（含 LLM_API_KEY，禁止提交）
.env
ai/.env
ai/data/
ai/*.log

# 本地下载的 AI / Embedding 模型（如 bge-small-zh-v1.5，约 93MB，禁止提交）
models/
!ai/app/models/
!ai/app/models/*.py

# ===== Claude 本机配置 =====
.claude/

# ===== 日志 =====
*.log
logs/

# ===== 本地 Obsidian 笔记库（个人笔记，非项目源码）=====
知识库/

# ===== Obsidian 编辑器状态（窗口布局等，非项目内容）=====
**/.obsidian/

# ===== 评测生成产物（由 eval 重新生成，不纳入基线源码）=====
eval/reports/

# ===== pytest 缓存与隔离运行目录 =====
.pytest_cache/
**/.pytest_cache/
.pytest-temp-*/
.pytest-tmp-*/
pytest-ai-*/
tmp/pytest-*/
scripts/boundary-validation/tmp*/

# ===== archify 架构可视化检查产物（生成图/html/json，非源码）=====
docs/arch/*.visual-check.*
docs/architecture/*.visual-check.*

# 本机 Git 提交消息草稿
tmp/commit-msg-*.txt

# 本机临时脚本、截图、诊断记录与个人模型额度快照
/tmp/
/.preview/
/free_quota_models.csv

# ===== 排错临时文件 =====
backup_err.txt
