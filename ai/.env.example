# ===== AI 服务环境变量 =====
# 使用方式：复制本文件为 ai/.env 后填写（或直接在系统环境变量里导出）。
# 未安装 python-dotenv 时，.env 不会自动加载，请直接导出环境变量。
#
# 维护入口（AI-06 收口口径）：
#   · 容器部署：**仓库根 `.env` 是唯一入口**，`docker-compose.yml` 的 `ai.environment`
#     以白名单方式转发本文件列出的开关，并带与代码一致的默认值。只改本模板不会影响容器。
#   · 裸跑（uvicorn）：`ai/.env` 覆盖根 `.env`，两者同名冲突时以 `ai/.env` 为准。
#   · 模型运行参数保存在模型管理中；本文件只配置 AI 服务基础设施。
#   · 一致性自检：`python scripts/check_ai_config_forwarding.py`。

# --- 内部调用鉴权（必填）---
# 与 Java 的 ai.client.internal-token 同一个值；缺失时 Python 侧拒绝启动。
# 生成：openssl rand -hex 32
INTERNAL_API_TOKEN=

# --- 解析与切块 ---
# 向量维度由知识库活动索引决定，支持 1024 / 2560；不能用全局变量切换。
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- 模型管理 ---
# Chat / Embedding / Rerank 在登录后的“设置 → 模型”管理；不再从 dotenv 选模型。
# Java 保存模型/凭证/用途绑定，内部请求向 Python 传 modelExecution。
# 云端密钥不写入本模板；部署主密钥由 Java 的 MODEL_CONFIG_ENCRYPTION_KEY 提供。
# 迁移和首次配置见 docs/model-management.md。

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge

# --- 只读 PG（决策文档 §4 第 5 项「重切边界」：/rag/query 直连检索）---
# Python 侧首次获得只读 DB 访问，只在 Java 授权后传入的 knowledgeBaseIds 范围内读 document_chunk。
# 安全边界不变：授权仍在 Java；连接层加 default_transaction_read_only=on 作纵深防御，Python 绝不写库。
# 必须显式配置专用只读身份；AI 不回落到后端可能有写权限的 POSTGRES_* 账号。
# PG_READONLY_HOST=localhost
# PG_READONLY_PORT=5432
# PG_READONLY_DB=knowledge
# PG_READONLY_USER=rag_readonly
# PG_READONLY_PASSWORD=由受控部署配置提供

# --- RAG 查询预算与 admission 上限 ---
# 与根目录 docker-compose.yml 默认值一致；生成问答总预算 270s，Java AI 读取预留 5s。
RAG_QUERY_DEADLINE_MS=270000
RAG_QUERY_MAX_INFLIGHT=4
RAG_QUERY_MAX_TOP_K=20
RAG_QUERY_MAX_RECALL_N=100
RAG_QUERY_MAX_HISTORY_MESSAGES=32
RAG_QUERY_MAX_HISTORY_CHARS=30000
RAG_RETRIEVAL_MAX_INFLIGHT=4

# --- 并行召回：单路硬超时（对齐 Java rag.budget.retrieval-ms）---
# /rag/query 的向量 / 关键词两路召回并发跑，任一路超过该毫秒数即降级为「该路无结果」，
#   另一路照常出结果；两路都超时才走空证据短路。<=0 = 不设单路上限（只用于对照，勿用于生产）。
# 为什么必须有（2026-09-27 观察期实测）：Java 分段路径一直有这套降级，Python 侧原先**串行且无超时**——
#   本机 8G 显存下 Ollama embedding 被抢是常态（40 分钟内该超时实测触发 30 次），
#   Java 发起的纯检索和 Agent 知识工具使用最多 35s 的查询预算。
# 单路超时先让另一条召回腿继续；底层 IO 受剩余预算内的客户端超时约束，远端推理端仍可能继续计算。
RETRIEVAL_LEG_TIMEOUT_MS=2000

# --- 证据准入 ---
# 评分阈值与校准记录保存到具体模型的语义指纹，不再使用全局 env 阈值。
# score：使用已校准重排评分；support：使用 evidence_support 用途绑定的审查模型。
RAG_EVIDENCE_MODE=score
RAG_EVIDENCE_POLICY_VERSION=fail-closed-v1

# --- 本地模型共享资源 ---
# 一个 Python worker / 实例内按资源组限流，所有本地模型默认共用 local-gpu。
# 模型记录中的 maxConcurrency 与资源组总容量分别生效，等待也计入调用总预算。
MODEL_RESOURCE_GROUPS={"local-gpu":1}
MODEL_RESOURCE_QUEUE_LIMIT=8
# 指标端点受 X-Internal-Token 保护。
METRICS_ENABLED=true

# --- 阶段级埋点（决策文档 §3.3 / §5.12.5）---
# 管线搬进 Python 后，Java RagStageTracer 不再覆盖 RAG 各阶段（观察期实测：同一次 chat
#   分段档 spanCount=6 → python 档 spanCount=0）。阶段埋点已随管线搬到
#   ai/app/observability/stage_trace.py，三个出口：
#     ① /rag/query 响应里的 stages[]（Java 写回 RagTrace，/observability/trace 恢复阶段名单）——默认路径
#     ② 结构化日志一行一条请求（RAG_STAGE_LOG_ENABLED）——默认开
#     ③ OTel span（OTEL_ENABLED）——默认关闭，只有明确接入外部观测平台时启用。
# 默认业务 Compose 固定关闭出口；docker-compose.observability.yml 显式开启。
# 裸跑时进程环境优先于 dotenv；已有显式 true 不会被代码默认值覆盖。
RAG_STAGE_LOG_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ekip-ai
# OTLP/HTTP traces 端点。自托管 Langfuse 的 OTLP 入口形如：
#   http://<langfuse-host>:3000/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# --- RAG 生成（05 章 3.1 P1-11 / 06 章 3.1 P1-6）---
# 多轮对话历史进 generate prompt 的**硬额度**（token）。从最近的消息往前装，
#   装不下就丢更早的消息（只有最新一条自己超额度时才截断它）——
#   此额度与模型上下文预算共同约束最终提示词，不决定实际模型。
RAG_GENERATE_HISTORY_TOKENS=300

# Ordinary startup uses production mode. The optional development overlay enables direct-chat test mode.
EKIP_ENV=production
RAG_DEV_TEST_MODE=false
